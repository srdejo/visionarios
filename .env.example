# Copy to .env and adjust for local development.
# Defaults assume the shared native Postgres instance from infra/ (see infra/README.md) —
# only override what you need to change.

DB_NAME=visionarios
DB_USER=visionarios
DB_PASSWORD=visionarios

# Secreto de firma de JWT (HMAC, minimo 32 bytes). En produccion (perfil "prod")
# es obligatorio: el backend no arranca si falta. Generar uno unico, ej:
#   openssl rand -base64 48
JWT_SECRET=visionarios-dev-secret-change-me-please-32-bytes-min

# Origen(es) permitidos por CORS, separados por coma. En produccion (perfil "prod")
# es obligatorio y NO debe incluir localhost ni wildcards.
#   Local:      CORS_ALLOWED_ORIGIN=http://localhost:4200
#   Produccion: CORS_ALLOWED_ORIGIN=https://visionarios.micasachurch.co
CORS_ALLOWED_ORIGIN=http://localhost:4200

# URL publica del frontend, usada para construir los enlaces de los correos
# (recuperar contraseña, invitacion de administrador, invitacion de evento).
APP_PUBLIC_URL=http://localhost:4200

# contact-api (ver ../contact) es quien realmente envia los correos.
CONTACT_API_URL=http://localhost:3000
MAIL_FROM_NAME=Red de Visionarios

# Opcional. Si un usuario con este correo ya se registro (via /registro), se lo
# promueve a ADMIN al arrancar el backend — resuelve crear el primer admin sin
# tocar la base de datos a mano. No hace nada si el usuario no existe todavia o
# si ya es ADMIN (idempotente). Dejar vacio despues del primer uso.
# ADMIN_BOOTSTRAP_EMAIL=tu-correo@ejemplo.com
